@{
    ViewData["Title"] = "Home Page";
}
 
<h2>Calendario de estados del escenario</h2>

<h2 class="mb-3">Calendario - Volley Playa</h2>

<div id="calendar" class="calendar-wrapper"></div>

<div class="modal fade" id="reservaModal" tabindex="-1" aria-labelledby="reservaModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="reservaForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="reservaModalLabel">Nueva reserva</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="reservaUsuario" class="form-label">Nombre</label>
                        <input type="text" id="reservaUsuario" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="reservaActividad" class="form-label">Actividad</label>
                        <input type="text" id="reservaActividad" class="form-control" required />
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Horario seleccionado</label>
                        <div id="reservaHorario" class="small text-muted"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Confirmar reserva</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ESTADOS = {
                Disponible: { color: '#28a745' },
                PracticaDeportiva: { color: '#0d6efd' },
                PracticaLibre: { color: '#dc3545' }
            };

            const calendarEl = document.getElementById('calendar');
            const reservaModalEl = document.getElementById('reservaModal');
            const reservaModal = new bootstrap.Modal(reservaModalEl);
            const reservaForm = document.getElementById('reservaForm');
            const reservaHorario = document.getElementById('reservaHorario');
            let selectedEvent = null;

            const eventosIniciales = [
                { title: 'Disponible', start: '2026-05-25T08:00:00', end: '2026-05-25T09:00:00', estado: 'Disponible' },
                { title: 'PracticaDeportiva', start: '2026-05-25T09:00:00', end: '2026-05-25T10:00:00', estado: 'PracticaDeportiva' },
                { title: 'PracticaLibre', start: '2026-05-26T10:00:00', end: '2026-05-26T11:00:00', estado: 'PracticaLibre' },
                { title: 'Disponible', start: '2026-05-27T12:00:00', end: '2026-05-27T13:00:00', estado: 'Disponible' },
                { title: 'Disponible', start: '2026-05-28T16:00:00', end: '2026-05-28T17:00:00', estado: 'Disponible' }
            ];

            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek',
                locale: 'es',
                slotMinTime: '06:00:00',
                slotMaxTime: '21:00:00',
                allDaySlot: false,
                nowIndicator: true,
                eventDidMount: function (info) {
                    const estado = info.event.extendedProps.estado;
                    const esDisponible = estado === 'Disponible';

                    info.el.classList.add(esDisponible ? 'estado-disponible' : 'estado-no-disponible');
                    info.el.style.backgroundColor = ESTADOS[estado]?.color ?? '#6c757d';
                    info.el.style.borderColor = ESTADOS[estado]?.color ?? '#6c757d';
                },
                eventClick: function (info) {
                    handleReservaClick(info.event);
                },
                events: eventosIniciales
            });

            calendar.render();

            function handleReservaClick(evento) {
                const estado = evento.extendedProps.estado;
                if (estado !== 'Disponible') {
                    return;
                }

                selectedEvent = evento;
                reservaHorario.textContent = `${evento.start.toLocaleString('es-ES')} - ${evento.end.toLocaleString('es-ES')}`;
                reservaForm.reset();
                reservaModal.show();
            }

            reservaForm.addEventListener('submit', function (e) {
                e.preventDefault();
                if (!selectedEvent) {
                    return;
                }

                selectedEvent.setProp('title', 'Ocupado');
                selectedEvent.setExtendedProp('estado', 'Ocupado');
                selectedEvent.setProp('backgroundColor', '#6c757d');
                selectedEvent.setProp('borderColor', '#6c757d');
                selectedEvent.setProp('classNames', ['estado-no-disponible']);

                reservaModal.hide();
                selectedEvent = null;
            });
        });
    </script>
}
